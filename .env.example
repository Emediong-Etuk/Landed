# ---- Web app (Vercel) ----
# Keyed devnet RPC (e.g. Helius). Server-side only; the browser goes through /api/rpc.
LANDED_L1_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_ER_URL=https://devnet-eu.magicblock.app
NEXT_PUBLIC_ER_WS_URL=wss://devnet-eu.magicblock.app
# Gas top-up faucet key for guest burners (base58 or JSON array). Server env only, never logged.
LANDED_FAUCET_SECRET=
LANDED_TOPUP_DAILY_SOL=5
# Cloudflare Turnstile (invisible/managed). Leave empty locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST for rate limits (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Keeper health endpoint (optional)
KEEPER_URL=
# Videos (YouTube unlisted / Loom / /videos/*.mp4). Empty = "Video coming soon".
NEXT_PUBLIC_PITCH_VIDEO_URL=
NEXT_PUBLIC_TECH_VIDEO_URL=
NEXT_PUBLIC_REPO_URL=https://github.com/emediong-etuk/landed

# ---- Keeper (services/keeper) ----
LANDED_L1_RPC=https://api.devnet.solana.com
LANDED_ER_RPC=https://devnet-eu.magicblock.app
KEEPER_KEYPAIR=          # low-balance hot key (base58, JSON array, or path)
BOT_1_KEYPAIR=
BOT_2_KEYPAIR=
BOTS_ENABLED=true
BOTS_AUTOPLAY=false
PORT=8787

# ---- Scripts / campaigns ----
LANDED_ADMIN_KEYPAIR=~/.config/solana/id.json
